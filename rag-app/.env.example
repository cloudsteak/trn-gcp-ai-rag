# Másold ezt a fájlt .env névre, és töltsd ki.
#   Mac / Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# A .env fájlt SOHA ne commitold (jelszót nem tartalmaz, de a projektazonosítód
# és a RAG corpus neved benne van).

# ---------------------------------------------------------------------------
# Google Cloud projekt
# ---------------------------------------------------------------------------
# A projekt ID a Google Cloud Console tetején látható, vagy:
#   gcloud config get-value project
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_PROJECT_ID

# A Cloud Run szolgáltatások és a RAG Engine régiója.
GOOGLE_CLOUD_LOCATION=europe-west1

# ---------------------------------------------------------------------------
# LLM (Gemini Enterprise Agent Platform)
# ---------------------------------------------------------------------------
# A gemini-3.5-flash-lite globális modell: a hívás location-je "global".
LLM_LOCATION=global
LLM_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# RAG Engine
# ---------------------------------------------------------------------------
# A korábban, kézzel létrehozott Rag Corpus teljes erőforrásneve.
# Formátum:
#   projects/PROJEKT_ID/locations/europe-west1/ragCorpora/CORPUS_ID
#
# Hol találod: Google Cloud Console → Agent Platform / Vertex AI → RAG Engine
RAG_CORPUS=projects/REPLACE_WITH_PROJECT_ID/locations/europe-west1/ragCorpora/REPLACE_WITH_CORPUS_ID

# Hány dokumentumrészletet kérjen a RAG Engine (több + ranker = jobb találat).
RAG_TOP_K=10

# A vektoros keresés után a ranker a kérdéshez igazítja a sorrendet.
# Kell hozzá: gcloud services enable discoveryengine.googleapis.com
RAG_RANKER=semantic-ranker-default@latest

# ---------------------------------------------------------------------------
# Helyi futtatás (client)
# ---------------------------------------------------------------------------
# A böngésző ebből a címről hívja a backendet. Helyben ez localhost.
# Cloud Run-on a client konténer ezt a deploy script tölti ki.
API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Cloud Run / setup scriptek
# ---------------------------------------------------------------------------
CLOUD_RUN_SERVER_NAME=rag-app-server
CLOUD_RUN_CLIENT_NAME=rag-app-client
SERVER_SA_NAME=rag-app-server
CLIENT_SA_NAME=rag-app-client
